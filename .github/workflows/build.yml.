name: Build ChordForge
on:
  push:
  workflow_dispatch:
jobs:
  windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - name: Configure
        run: cmake -B build -DCMAKE_BUILD_TYPE=Release
      - name: Build VST3
        run: cmake --build build --config Release --target ChordForge_VST3 -j 4
      - uses: actions/upload-artifact@v4
        with:
          name: ChordForge-VST3-Windows
          path: build/ChordForge_artefacts/Release/VST3/ChordForge.vst3
